---
import { base, themeConfig } from '@/config'
import { giscusLocaleMap } from '@/i18n/config'
import { getLangFromPath } from '@/i18n/lang'

const {
  repo = '',
  repoId = '',
  category = '',
  categoryId = '',
  mapping = 'pathname',
  strict = '0',
  reactionsEnabled = '1',
  emitMetadata = '0',
  inputPosition = 'bottom',
} = themeConfig.comment.giscus ?? {}


const lang = getLangFromPath(Astro.url.pathname)

const giscusConfig = {
  base,
  repo,
  repoId,
  category,
  categoryId,
  mapping,
  strict,
  reactionsEnabled,
  emitMetadata,
  inputPosition,
  lang: giscusLocaleMap[lang],
}
---

<div
  id="giscus"
  class="giscus mt-16"
  data-config={JSON.stringify(giscusConfig)}
/>

<!-- Giscus Script >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> -->
<script>
let observer: IntersectionObserver | undefined

function getThemeUrl(base: string) {
  const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light'
  return `${location.origin}${base}/giscus/theme-${theme}.css`
}

function setupGiscus() {
  observer?.disconnect()
  const container = document.getElementById('giscus')
  if (!container) {
    return
  }
  observer = new IntersectionObserver((entries) => {
    if (!entries.some(entry => entry.isIntersecting)) {
      return
    }
    observer!.disconnect()
    const { base, category, ...options } = JSON.parse(container.dataset.config!)
    const script = document.createElement('script')
    script.src = 'https://giscus.app/client.js'
    script.crossOrigin = 'anonymous'
    script.async = true
    Object.assign(script.dataset, options, {
      ...(category && { category }),
      theme: getThemeUrl(base),
    })
    script.onerror = () => console.error('[Giscus] Failed to load comments')
    container.appendChild(script)
  }, { rootMargin: '500px' })
  observer.observe(container)
}

document.addEventListener('astro:page-load', setupGiscus)
document.addEventListener('astro:before-swap', () => observer?.disconnect())
document.addEventListener('theme-changed', () => {
  const container = document.getElementById('giscus')
  const frame = container?.querySelector<HTMLIFrameElement>('iframe.giscus-frame')
  if (frame?.contentWindow) {
    const { base } = JSON.parse(container!.dataset.config!)
    frame.contentWindow.postMessage({ giscus: { setConfig: { theme: getThemeUrl(base) } } }, 'https://giscus.app')
  }
})
</script>
