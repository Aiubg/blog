---
import twikooJS from 'twikoo/dist/twikoo.all.nocss.js?url' // Keep styles separate for page transitions and bundle every locale
import twikooCSS from 'twikoo/dist/twikoo.css?url'
import { defaultLocale, themeConfig } from '@/config'
import { twikooLocaleMap } from '@/i18n/config'
import { getLangFromPath } from '@/i18n/lang'
import { getNextLangPath } from '@/i18n/path'

const { envId = '' } = themeConfig.comment.twikoo ?? {}

const lang = getLangFromPath(Astro.url.pathname)
const twikooPath = getNextLangPath(Astro.url.pathname, lang, defaultLocale)

const twikooConfig = {
  envId,
  path: twikooPath,
  lang: twikooLocaleMap[lang],
  twikooCSS,
  twikooJS,
}
---

<!-- Class not working on twikoo div -->
<div
  id="twikoo-wrapper"
  class="no-heti mt-16"
  data-config={JSON.stringify(twikooConfig)}
>
  <div id="twikoo" />
</div>

<script>
interface TwikooConfig {
  envId: string
  path: string
  lang: string
  twikooCSS: string
  twikooJS: string
}
declare const twikoo: {
  init: (options: { envId: string, el: HTMLElement, path: string, lang: string }) => Promise<void>
}

let observer: IntersectionObserver | undefined
let libraryLoading: Promise<void> | undefined

async function initialize(container: HTMLElement) {
  const config: TwikooConfig = JSON.parse(container.dataset.config!)
  if (!document.getElementById('twikoo-css')) {
    const stylesheet = document.createElement('link')
    stylesheet.id = 'twikoo-css'
    stylesheet.rel = 'stylesheet'
    stylesheet.href = config.twikooCSS
    document.head.appendChild(stylesheet)
  }
  libraryLoading ??= new Promise<void>((resolve, reject) => {
    const script = document.createElement('script')
    script.src = config.twikooJS
    script.onload = () => resolve()
    script.onerror = () => reject(new Error('Failed to load Twikoo'))
    document.head.appendChild(script)
  })
  await libraryLoading
  if (!container.isConnected) {
    return
  }
  await twikoo.init({ envId: config.envId, el: container.querySelector<HTMLElement>('#twikoo')!, path: config.path, lang: config.lang })
}

function setupTwikoo() {
  observer?.disconnect()
  const container = document.getElementById('twikoo-wrapper')
  if (!container) {
    return
  }
  observer = new IntersectionObserver((entries) => {
    if (entries.some(entry => entry.isIntersecting)) {
      observer!.disconnect()
      initialize(container).catch(error => console.error('[Twikoo]', error))
    }
  }, { rootMargin: '500px' })
  observer.observe(container)
}

document.addEventListener('astro:page-load', setupTwikoo)
document.addEventListener('astro:before-swap', () => observer?.disconnect())
</script>
