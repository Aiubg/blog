---
import { base, themeConfig } from '@/config'

const sound = themeConfig.sound
const config = {
  basePath: sound?.basePath ?? base,
  mobileEnabled: sound?.mobileEnabled ?? false,
  click: { enabled: sound?.click?.enabled ?? true, volume: sound?.click?.volume ?? 0.8 },
  typing: { enabled: sound?.typing?.enabled ?? true, volume: sound?.typing?.volume ?? 0.4 },
}
---

{(sound?.enabled ?? true) && <div id="sound-config" hidden data-config={JSON.stringify(config)} />}

<script>
const element = document.getElementById('sound-config')
if (element) {
  import('../../scripts/sound').then(({ setupSound }) => {
    setupSound(JSON.parse(element.dataset.config!))
  })
}
</script>
