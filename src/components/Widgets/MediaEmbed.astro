---
import 'lite-youtube-embed/src/lite-yt-embed.css'
---

<script>
let mermaidObserver: IntersectionObserver | null = null
let mermaidRendering = Promise.resolve()
let twitterLoading: Promise<void> | undefined

function renderMermaids(nodes: HTMLElement[], reset = false) {
  // Mermaid shares a global configuration. Serialize rendering and theme changes.
  mermaidRendering = mermaidRendering.then(async () => {
    const { default: mermaid } = await import('mermaid')
    const connectedNodes = nodes.filter(node => node.isConnected)
    if (!connectedNodes.length) {
      return
    }

    for (const node of connectedNodes) {
      node.dataset.mermaidCode ??= node.textContent!.trim()
      if (reset) {
        node.textContent = node.dataset.mermaidCode
        node.removeAttribute('data-processed')
      }
    }

    mermaid.initialize({
      startOnLoad: false,
      layout: 'dagre',
      look: 'classic',
      theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
    })
    await mermaid.run({ nodes: connectedNodes })
  }).catch(error => console.error('[Mermaid]', error))
}

async function setupTwitterEmbeds() {
  const tweets = document.querySelectorAll<HTMLElement>('.twitter-tweet')
  if (!tweets.length) {
    return
  }
  const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light'
  tweets.forEach(tweet => tweet.dataset.theme = theme)

  twitterLoading ??= new Promise<void>((resolve, reject) => {
    const script = document.createElement('script')
    script.src = 'https://platform.twitter.com/widgets.js'
    script.async = true
    script.onload = () => resolve()
    script.onerror = () => reject(new Error('Failed to load Twitter widgets'))
    document.head.appendChild(script)
  })
  await twitterLoading
  window.twttr.widgets.load()
}

function setupMediaEmbeds() {
  if (document.querySelector('lite-youtube') && !customElements.get('lite-youtube')) {
    // @ts-expect-error - lite-youtube-embed does not ship type definitions.
    import('lite-youtube-embed').catch(error => console.error('[YouTube]', error))
  }
  setupTwitterEmbeds().catch(error => console.error('[Twitter]', error))

  mermaidObserver?.disconnect()
  const nodes = document.querySelectorAll<HTMLElement>('pre.mermaid')
  if (!nodes.length) {
    return
  }
  mermaidObserver = new IntersectionObserver((entries) => {
    const visible = entries.filter(entry => entry.isIntersecting)
    visible.forEach(entry => mermaidObserver!.unobserve(entry.target))
    if (visible.length) {
      renderMermaids(visible.map(entry => entry.target as HTMLElement))
    }
  }, { rootMargin: '300px' })
  nodes.forEach(node => mermaidObserver!.observe(node))
}

function handleGalleryWheel(e: WheelEvent) {
  const container = (e.target as Element)?.closest('.gallery-container') as HTMLElement
  if (!container) {
    return
  }

  const previousScrollLeft = container.scrollLeft
  container.scrollLeft += e.deltaY
  if (container.scrollLeft === previousScrollLeft) {
    return
  }

  e.preventDefault()
}

document.addEventListener('astro:page-load', setupMediaEmbeds)
document.addEventListener('astro:before-swap', () => mermaidObserver?.disconnect())
document.addEventListener('theme-changed', () => {
  const nodes = [...document.querySelectorAll<HTMLElement>('pre.mermaid[data-processed]')]
  if (nodes.length) {
    renderMermaids(nodes, true)
  }
})
document.addEventListener('wheel', handleGalleryWheel, { passive: false })
</script>
