<script>
interface GithubRepoData {
  owner: { avatar_url: string }
  description: string | null
  stargazers_count: number
  forks_count: number
  license: { spdx_id: string } | null
}

const numberFormat = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 })
const requests = new Map<string, Promise<GithubRepoData>>()
let observer: IntersectionObserver | null = null

function getRepoData(repo: string): Promise<GithubRepoData> {
  let request = requests.get(repo)
  if (!request) {
    request = fetch(`https://api.github.com/repos/${repo}`).then((response) => {
      if (!response.ok) {
        throw new Error(`GitHub returned ${response.status} for ${repo}`)
      }
      return response.json() as Promise<GithubRepoData>
    })
    requests.set(repo, request)
    request.catch(() => requests.delete(repo))
  }
  return request
}

async function loadCard(card: HTMLElement) {
  const setText = (selector: string, text: string) => {
    card.querySelector<HTMLElement>(selector)!.textContent = text
  }

  try {
    const data = await getRepoData(card.dataset.repo!)
    if (!card.isConnected) {
      return
    }
    card.querySelector<HTMLElement>('.gc-owner-avatar')!.style.backgroundImage = `url("${data.owner.avatar_url}")`
    setText('.gc-repo-description', data.description ?? 'No description')
    setText('.gc-stars-count', numberFormat.format(data.stargazers_count))
    setText('.gc-forks-count', numberFormat.format(data.forks_count))
    setText('.gc-license-info', data.license?.spdx_id ?? 'No License')
  }
  catch (error) {
    setText('.gc-repo-description', 'Failed to load data')
    console.error('[GithubCard]', error)
  }
}

function setupGithubCards() {
  observer?.disconnect()
  const cards = document.querySelectorAll<HTMLElement>('.gc-container')
  if (!cards.length) {
    return
  }

  observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        observer!.unobserve(entry.target)
        void loadCard(entry.target as HTMLElement)
      }
    }
  }, { rootMargin: '300px' })
  cards.forEach(card => observer!.observe(card))
}

document.addEventListener('astro:page-load', setupGithubCards)
document.addEventListener('astro:before-swap', () => observer?.disconnect())
</script>
