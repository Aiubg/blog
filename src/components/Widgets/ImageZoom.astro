<script>
const runtime = window as typeof window & {
  __retypeset?: { listeners?: Record<string, boolean> }
}
const retypeset = runtime.__retypeset ?? (runtime.__retypeset = {})
const listeners = retypeset.listeners ?? (retypeset.listeners = {})

const CLOSE_ICON_SVG = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4Z"/></svg>'

const MIN_SCALE_RATIO = 0.5
const MAX_SCALE_RATIO = 8
const CLOSE_DURATION_MS = 300

interface PointerPos { x: number, y: number }
interface PinchStart {
  distance: number
  scale: number
  pImgX: number
  pImgY: number
}

const ImageZoom = {
  overlay: null as HTMLDivElement | null,
  closeButton: null as HTMLButtonElement | null,
  zoomedImg: null as HTMLImageElement | null,
  originalImg: null as HTMLImageElement | null,
  rect: null as DOMRect | null,
  fitScale: 1,
  state: { scale: 1, x: 0, y: 0 },
  pointers: new Map<number, PointerPos>(),
  pointerMoved: false,
  pointerDownOnOverlay: false,
  pinchStart: null as PinchStart | null,

  createOverlay() {
    if (this.overlay && this.overlay.isConnected) {
      return
    }

    const overlay = document.createElement('div')
    overlay.classList.add('zoom-overlay')
    overlay.setAttribute('role', 'dialog')
    overlay.setAttribute('aria-modal', 'true')
    overlay.setAttribute('aria-label', 'Image Viewer')
    overlay.setAttribute('tabindex', '-1')
    overlay.setAttribute('aria-hidden', 'true')

    const closeButton = document.createElement('button')
    closeButton.type = 'button'
    closeButton.classList.add('zoom-close-button')
    closeButton.setAttribute('aria-label', 'Close image viewer')
    closeButton.innerHTML = CLOSE_ICON_SVG
    overlay.appendChild(closeButton)

    document.body.appendChild(overlay)
    this.overlay = overlay
    this.closeButton = closeButton

    overlay.addEventListener('pointerdown', e => this.onPointerDown(e))
    overlay.addEventListener('pointermove', e => this.onPointerMove(e))
    overlay.addEventListener('pointerup', e => this.onPointerUp(e))
    overlay.addEventListener('pointercancel', e => this.onPointerUp(e))
    overlay.addEventListener('wheel', e => this.onWheel(e), { passive: false })
    overlay.addEventListener('contextmenu', e => e.preventDefault())
    closeButton.addEventListener('click', (e) => {
      e.stopPropagation()
      this.close()
    })
  },

  computeFitScale(rect: DOMRect) {
    const vw = window.innerWidth
    const vh = window.innerHeight
    const factor = vw < 768 ? 0.95 : 0.85
    return Math.min((vw * factor) / rect.width, (vh * factor) / rect.height)
  },

  applyTransform(animate: boolean) {
    if (!this.zoomedImg) {
      return
    }
    this.zoomedImg.style.transition = animate ? 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)' : 'none'
    this.zoomedImg.style.transform = `translate3d(${this.state.x}px, ${this.state.y}px, 0) scale(${this.state.scale})`
  },

  centerOffset(scale: number) {
    if (!this.rect) {
      return { x: 0, y: 0 }
    }
    return {
      x: window.innerWidth / 2 - this.rect.left - (this.rect.width * scale) / 2,
      y: window.innerHeight / 2 - this.rect.top - (this.rect.height * scale) / 2,
    }
  },

  zoomImg(img: HTMLImageElement) {
    if (!this.overlay) {
      return
    }

    document.body.style.overflow = 'hidden'
    this.rect = img.getBoundingClientRect()
    this.originalImg = img
    this.fitScale = this.computeFitScale(this.rect)
    this.overlay.setAttribute('aria-hidden', 'false')

    const zoomedImg = img.cloneNode() as HTMLImageElement
    zoomedImg.classList.add('zoomed-img')
    zoomedImg.draggable = false
    Object.assign(zoomedImg.style, {
      position: 'fixed',
      top: `${this.rect.top}px`,
      left: `${this.rect.left}px`,
      width: `${this.rect.width}px`,
      height: `${this.rect.height}px`,
    })

    this.state = { scale: 1, x: 0, y: 0 }
    this.zoomedImg = zoomedImg
    this.applyTransform(false)
    this.overlay.appendChild(zoomedImg)
    this.overlay.classList.add('is-open')

    requestAnimationFrame(() => {
      const offset = this.centerOffset(this.fitScale)
      this.state.scale = this.fitScale
      this.state.x = offset.x
      this.state.y = offset.y
      this.applyTransform(true)
      this.overlay?.focus()
    })
  },

  close() {
    if (!this.overlay || !this.zoomedImg || !this.originalImg) {
      return
    }

    this.overlay.setAttribute('aria-hidden', 'true')
    this.overlay.classList.remove('is-open')

    this.state.scale = 1
    this.state.x = 0
    this.state.y = 0
    this.applyTransform(true)

    document.body.style.overflow = ''
    this.pointers.clear()
    this.pinchStart = null
    this.pointerMoved = false
    this.pointerDownOnOverlay = false

    setTimeout(() => {
      if (this.zoomedImg?.parentNode) {
        this.zoomedImg.parentNode.removeChild(this.zoomedImg)
      }
      this.zoomedImg = null
      if (this.originalImg) {
        this.originalImg.focus()
      }
      this.originalImg = null
      this.rect = null
    }, CLOSE_DURATION_MS)
  },

  zoomAt(clientX: number, clientY: number, factor: number) {
    if (!this.zoomedImg || !this.rect) {
      return
    }
    const minScale = this.fitScale * MIN_SCALE_RATIO
    const maxScale = this.fitScale * MAX_SCALE_RATIO
    const newScale = Math.max(minScale, Math.min(maxScale, this.state.scale * factor))
    if (newScale === this.state.scale) {
      return
    }

    const pImgX = (clientX - this.rect.left - this.state.x) / this.state.scale
    const pImgY = (clientY - this.rect.top - this.state.y) / this.state.scale
    this.state.x = clientX - this.rect.left - pImgX * newScale
    this.state.y = clientY - this.rect.top - pImgY * newScale
    this.state.scale = newScale
    this.applyTransform(false)
  },

  onPointerDown(e: PointerEvent) {
    if (!this.overlay || !this.zoomedImg) {
      return
    }
    if (e.target instanceof Element && e.target.closest('.zoom-close-button')) {
      return
    }

    e.preventDefault()
    this.overlay.setPointerCapture(e.pointerId)
    this.pointers.set(e.pointerId, { x: e.clientX, y: e.clientY })
    this.pointerMoved = false
    this.pointerDownOnOverlay = e.target === this.overlay

    if (this.pointers.size === 1) {
      this.zoomedImg.classList.add('is-dragging')
      this.pinchStart = null
    }
    else if (this.pointers.size === 2) {
      this.zoomedImg.classList.remove('is-dragging')
      this.beginPinch()
    }
  },

  beginPinch() {
    if (!this.rect) {
      return
    }
    const points = Array.from(this.pointers.values())
    const [p1, p2] = points
    const distance = Math.hypot(p2.x - p1.x, p2.y - p1.y)
    const midX = (p1.x + p2.x) / 2
    const midY = (p1.y + p2.y) / 2
    this.pinchStart = {
      distance,
      scale: this.state.scale,
      pImgX: (midX - this.rect.left - this.state.x) / this.state.scale,
      pImgY: (midY - this.rect.top - this.state.y) / this.state.scale,
    }
  },

  onPointerMove(e: PointerEvent) {
    if (!this.pointers.has(e.pointerId) || !this.zoomedImg) {
      return
    }
    const prev = this.pointers.get(e.pointerId)!
    const dx = e.clientX - prev.x
    const dy = e.clientY - prev.y
    this.pointers.set(e.pointerId, { x: e.clientX, y: e.clientY })

    if (Math.abs(dx) + Math.abs(dy) > 3) {
      this.pointerMoved = true
    }

    if (this.pointers.size === 1) {
      this.state.x += dx
      this.state.y += dy
      this.applyTransform(false)
      return
    }

    if (this.pointers.size === 2 && this.pinchStart && this.rect) {
      const [p1, p2] = Array.from(this.pointers.values())
      const distance = Math.hypot(p2.x - p1.x, p2.y - p1.y)
      const factor = distance / this.pinchStart.distance
      const minScale = this.fitScale * MIN_SCALE_RATIO
      const maxScale = this.fitScale * MAX_SCALE_RATIO
      const newScale = Math.max(minScale, Math.min(maxScale, this.pinchStart.scale * factor))
      const midX = (p1.x + p2.x) / 2
      const midY = (p1.y + p2.y) / 2
      this.state.scale = newScale
      this.state.x = midX - this.rect.left - this.pinchStart.pImgX * newScale
      this.state.y = midY - this.rect.top - this.pinchStart.pImgY * newScale
      this.applyTransform(false)
    }
  },

  onPointerUp(e: PointerEvent) {
    if (!this.zoomedImg) {
      return
    }
    if (this.overlay?.hasPointerCapture(e.pointerId)) {
      this.overlay.releasePointerCapture(e.pointerId)
    }
    const hadPointer = this.pointers.delete(e.pointerId)

    if (this.pointers.size < 2) {
      this.pinchStart = null
    }
    if (this.pointers.size === 1) {
      // Lifted one finger of a pinch: restart pan from the remaining finger
      this.zoomedImg.classList.add('is-dragging')
    }
    if (this.pointers.size === 0) {
      this.zoomedImg.classList.remove('is-dragging')
      // Click on overlay background (no significant move) closes the viewer
      if (hadPointer && !this.pointerMoved && this.pointerDownOnOverlay) {
        this.close()
      }
      this.pointerDownOnOverlay = false
    }
  },

  onWheel(e: WheelEvent) {
    if (!this.zoomedImg) {
      return
    }
    e.preventDefault()
    const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15
    this.zoomAt(e.clientX, e.clientY, factor)
  },

  setupOverlay() {
    this.createOverlay()
    this.zoomedImg = null
    this.originalImg = null
  },

  handleClick(event: MouseEvent) {
    if (this.zoomedImg) {
      return
    }

    const target = event.target
    if (!(target instanceof HTMLImageElement)) {
      return
    }
    if (!(target.complete && target.width >= 100 && target.height >= 100)) {
      return
    }

    this.zoomImg(target)
  },

  handleResize() {
    if (!this.zoomedImg) {
      return
    }
    this.close()
  },

  handleKey(event: KeyboardEvent) {
    if (!this.zoomedImg) {
      return
    }
    if (event.key === 'Escape') {
      event.preventDefault()
      this.close()
    }
  },

  init() {
    this.setupOverlay()

    if (listeners.imageZoom) {
      return
    }
    listeners.imageZoom = true

    document.addEventListener('astro:page-load', () => this.setupOverlay())
    document.addEventListener('click', event => this.handleClick(event), { passive: true })
    document.addEventListener('keydown', event => this.handleKey(event))
    window.addEventListener('resize', () => this.handleResize(), { passive: true })
  },
}

ImageZoom.init()
</script>

<style is:global>
.zoom-overlay {
  --at-apply: 'fixed inset-0 z-999 bg-background op-0 invisible';
  transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: zoom-out;
}
.zoom-overlay.is-open {
  --at-apply: 'op-100 visible';
}
.zoom-overlay .zoomed-img {
  --at-apply: 'select-none';
  transform-origin: 0 0;
  cursor: grab;
  touch-action: none;
  will-change: transform;
  -webkit-user-drag: none;
}
.zoom-overlay .zoomed-img.is-dragging {
  cursor: grabbing;
}

.zoom-close-button {
  --at-apply: 'fixed right-4 top-4 z-1000 grid aspect-square w-9 cursor-pointer place-items-center rounded-full';
  --at-apply: 'bg-background c-secondary/80 hover:c-primary';
  transition: color 0.15s ease-out, transform 0.15s ease-out;
}
.zoom-close-button:active {
  --at-apply: 'scale-90';
}
.zoom-close-button svg {
  --at-apply: 'aspect-square w-50%';
}
@media (min-width: 768px) {
  .zoom-close-button {
    --at-apply: 'right-6 top-6 w-10';
  }
}
</style>
