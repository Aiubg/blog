---
import type { Language } from '@/i18n/config'
import LanguageSwitcherIcon from '@/assets/icons/language-switcher.svg'
import ThemeToggleIcon from '@/assets/icons/theme-toggle.svg'
import { allLocales, themeConfig } from '@/config'
import { getLangFromPath, getNextGlobalLang } from '@/i18n/lang'
import {
  getLocalizedPath,
  getNextGlobalLangPath,
  getNextSupportedLangPath,
} from '@/i18n/path'
import { isPostPage } from '@/utils/page'

interface Props {
  supportedLangs: Language[]
}

const {
  light: { background: lightMode },
  dark: { background: darkMode },
} = themeConfig.color

const { supportedLangs } = Astro.props
const currentPath = Astro.url.pathname

const showLanguageSwitcher = allLocales.length > 1
const nextUrl
  = supportedLangs.length > 0
    ? getNextSupportedLangPath(currentPath, supportedLangs)
  : getNextGlobalLangPath(currentPath)
const isPost = isPostPage(currentPath)
const currentLang = getLangFromPath(currentPath)
const nextGlobalLang = getNextGlobalLang(currentLang)
const fallbackUrl = getLocalizedPath('/', nextGlobalLang)
const isSingleLangPost = isPost && supportedLangs.length <= 1
const targetUrl = isSingleLangPost ? fallbackUrl : nextUrl
const nextLang = getLangFromPath(targetUrl)
---

<div
  class:list={[
    'absolute right-7.25vw top-14.6 flex gap-6 min-[823px]:max-lg:right-[calc(50vw-22rem)]',
    'lg:(fixed bottom-[min(10.27rem+1.92vw,12rem)] right-[max(5rem,calc(50vw-35rem))] top-auto w-14rem)',
  ]}
>
  {
    showLanguageSwitcher && (
      <a
        id="language-switcher"
        href={targetUrl}
        data-next-lang={nextLang}
        class="aspect-square w-4 c-secondary active:scale-90 hover:c-primary"
        aria-label="Switch website language"
      >
        <LanguageSwitcherIcon aria-hidden="true" fill="currentColor" />
      </a>
    )
  }

  <button
    id="theme-toggle-button"
    data-light={lightMode}
    data-dark={darkMode}
    data-mode={themeConfig.color.mode}
    class="aspect-square w-4 c-secondary active:scale-90 hover:c-primary"
    aria-label="Switch light/dark theme"
  >
    <ThemeToggleIcon aria-hidden="true" fill="currentColor" />
  </button>
</div>

<script>
function applyTheme(isDark: boolean) {
  const button = document.getElementById('theme-toggle-button')!
  document.documentElement.classList.toggle('dark', isDark)
  document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = (isDark ? button.dataset.dark : button.dataset.light)!
  document.dispatchEvent(new Event('theme-changed'))
}

function toggleTheme() {
  const isDark = !document.documentElement.classList.contains('dark')
  localStorage.setItem('theme', isDark ? 'dark' : 'light')
  applyTheme(isDark)
}

document.addEventListener('click', (event) => {
  if (!(event.target instanceof Element)) {
    return
  }
  const languageLink = event.target.closest<HTMLAnchorElement>('#language-switcher')
  if (languageLink && event.button === 0 && !event.ctrlKey && !event.metaKey && !event.shiftKey && !event.altKey) {
    localStorage.setItem('lang', languageLink.dataset.nextLang!)
  }
  if (!event.target.closest('#theme-toggle-button')) {
    return
  }

  const root = document.documentElement
  if (root.classList.contains('reduce-motion')) {
    toggleTheme()
    return
  }
  root.style.setProperty('view-transition-name', 'animation-theme-toggle')
  root.setAttribute('data-theme-changing', '')
  const transition = document.startViewTransition(toggleTheme)
  const cleanup = () => {
    root.style.removeProperty('view-transition-name')
    root.removeAttribute('data-theme-changing')
  }
  transition.finished.then(cleanup, cleanup)
})

matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
  const button = document.getElementById('theme-toggle-button')!
  if (button.dataset.mode === 'auto' && !localStorage.getItem('theme')) {
    applyTheme(event.matches)
  }
})
</script>
